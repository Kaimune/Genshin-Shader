{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "23b93ab435e34224b5a39ec474ba224f",
    "m_Title": "Lerp Color and Alpha waterColor",
    "m_Content": "\rT = 0   → output A\r\nT = 1   → output B\r\nT = 0.5 → halfway between A and B\r\n\nSo think of Lerp as:\n\n“How much of A or B do I want here?”\n\nA = what you want when T is 0\nB = what you want when T is 1",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1284.6666259765625,
        "y": -676.6666870117188,
        "width": 254.0,
        "height": 220.0
    },
    "m_Group": {
        "m_Id": "992ed176c95645c091dbe117d9e890e4"
    }
}

