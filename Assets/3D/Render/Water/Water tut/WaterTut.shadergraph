{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d2871c7242c64436a12f7fdfa5e4e3db",
    "m_Title": "Normal Blend",
    "m_Content": "Normal maps store lighting direction vectors, and blending two normal maps means combining their surface perturbations and re-normalising the result — not averaging them.\n\nNormals cant be added or lerped on",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -700.6666870117188,
        "y": -1508.0,
        "width": 398.0000305175781,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": "6f9c904823004908ae76fec87a61ff3e"
    }
}

