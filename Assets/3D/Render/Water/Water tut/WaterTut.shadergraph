{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "76fce1fee1f84ab58985e76c97824e69",
    "m_Title": "Lighting",
    "m_Content": "This script calculates specular highlights (the shiny glints on water).\n\nit needs to know three directions at the current pixel:\n\nWhere the surface is facing → normalWS\n\nWhere the light is coming from → light.direction\n\nWhere the camera is → viewW\n",
