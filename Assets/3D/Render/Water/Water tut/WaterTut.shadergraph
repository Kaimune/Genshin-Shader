    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "7c818d69edd941b391a55a01b97c857d",
    "m_Title": "Int Foam Mask",
    "m_Content": "Screen Position supplies the UVs for sampling the depth buffer.\n\nDepth Fade returns a value that changes when geometry is close behind the water.\n\nadding 0.1 makes the foam actually visable\n\nsmoothstep cuts off stuff below water at a stepped rate",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 4237.33349609375,
        "y": 1334.666748046875,
        "width": 226.0,
        "height": 222.0
    },
    "m_Group": {
        "m_Id": "e128e3e4f60f495fac6afbc29fc5d464"
    }
}

{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "7cd20de6ea35497a80e3a20885ebe30f",
    "m_Group": {
        "m_Id": "3070ff5aff244828b67fe2bee9fe4971"
    },
    "m_Name": "DistortUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 3138.000244140625,
            "y": 913.3333129882813,
            "width": 211.333251953125,
            "height": 304.00006103515627
        }
    },
    "m_Slots": [
        {
            "m_Id": "bf9dcaf7a804497aa25d9a0a5af6755c"
        },
        {
            "m_Id": "73f7634c291f47aaac0f20552c0a534b"
        },
        {
            "m_Id": "3d852828f7c247ac8c33800c9dfde8e8"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 1,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "DistortUV",
    "m_FunctionSource": "f9682a62aee1443a58ccaaae00d22a8e",
    "m_FunctionBody": "void DistortUV_float(float2 UV, float Amount, out float2 Out)\r\n{\r\n    float time = _Time.y;\r\n\r\n    UV.y += Amount * 0.01 * (sin(UV.x * 3.5 + time * 0.35) + sin(UV.x * 4.8 + time * 1.05) + sin(UV.x * 7.3 + time * 0.45)) / 3.0;\r\n    UV.x += Amount * 0.12 * (sin(UV.y * 4.0 + time * 0.50) + sin(UV.y * 6.8 + time * 0.75) + sin(UV.y * 11.3 + time * 0.2)) / 3.0;\r\n    UV.y += Amount * 0.12 * (sin(UV.x * 4.2 + time * 0.64) + sin(UV.x * 6.3 + time * 1.65) + sin(UV.x * 8.2 + time * 0.45)) / 3.0;\r\n\r\n    Out = UV;\r\n}"
}

