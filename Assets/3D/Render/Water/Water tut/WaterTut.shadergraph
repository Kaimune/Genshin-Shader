{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d48a5a3d8bb344dbb121952f059f1186",
    "m_Title": "Underwater",
    "m_Content": "Alpha is NOT just transparency of the screen, its how much water is at this pixel. \n\nalpha = how much water color is already covering the pixel\r\n1 - alpha = how much background should show through\n\n\nAlpha\t     1 - Alpha\t\n1.0\t\t0.0\t\tFully water-colored, hide scene\n\n0.7\t\t0.3\t\tMostly water, little scene\n\n0.3\t\t0.7\t\tWeak water, lots of scene\n\n0.0\t\t1.0\t\tNo water color, show scene\n\nThis makes a mask for scene color to show our stuff below the water\n\nScene color = what we would see normally\n\nThis is to make a soft blending transition across the depthfade instead of a instant cutoff\n\n",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 2452.666748046875,
        "y": -99.33333587646485,
        "width": 462.0,
        "height": 384.0
    },
    "m_Group": {
        "m_Id": "52711e5f6f494fc2990419036ea15734"
    }
}

